# Apply the pinned cache lifetime/index fixes to a generated source copy only.
set_property(DIRECTORY PROPERTY GFX_GUI_REPLAY_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
function(gfx_gui_replay_cache)
    if(NOT TARGET gfxrecon_decode)
        return()
    endif()
    get_property(_root DIRECTORY PROPERTY GFX_GUI_REPLAY_ROOT)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_root}/cmake/gui_pipeline_cache_loader.inl")
    get_target_property(_sources gfxrecon_decode SOURCES)
    set(_original "")
    foreach(_file IN LISTS _sources)
        if(_file MATCHES "[/\\]vulkan_replay_consumer_base.cpp$")
            set(_original "${_file}")
        endif()
    endforeach()
    if(NOT _original)
        return()
    endif()
    file(READ "${_original}" _source)
    string(REPLACE "    object_info_table_ = CommonObjectInfoTable::GetSingleton();" "    GFXRECON_LOG_INFO(\"GfxReconGui indexed pipeline cache protocol 1\");\n    object_info_table_ = CommonObjectInfoTable::GetSingleton();" _source "${_source}")
    set(_before "    if (load_pipeline_caches_from_file)\n    {\n        std::vector<uint8_t> pipelineCacheData;")
    string(FIND "${_source}" "${_before}" _at)
    if(_at LESS 0)
        message(FATAL_ERROR "Pinned pipeline cache lifetime patch no longer matches")
    endif()
    string(REPLACE "${_before}" "    std::vector<uint8_t> pipelineCacheData; // Keep initial data alive through vkCreatePipelineCache.\n    if (load_pipeline_caches_from_file)\n    {" _source "${_source}")
    string(REPLACE "    VkPipelineCache pipelineCache;" "    VkPipelineCache pipelineCache = VK_NULL_HANDLE;" _source "${_source}")
    string(FIND "${_source}" "bool VulkanReplayConsumerBase::LoadPipelineCacheFromFile" _begin)
    string(FIND "${_source}" "void VulkanReplayConsumerBase::SavePipelineCache(" _end)
    if(_begin LESS 0 OR _end LESS _begin)
        message(FATAL_ERROR "Pinned cache reader patch no longer matches")
    endif()
    file(READ "${_root}/cmake/gui_pipeline_cache_loader.inl" _loader)
    string(SUBSTRING "${_source}" 0 ${_begin} _prefix)
    string(SUBSTRING "${_source}" ${_end} -1 _suffix)
    set(_source "${_prefix}bool VulkanReplayConsumerBase::LoadPipelineCacheFromFile(format::HandleId id, std::vector<uint8_t>& cache_data)\n{\n${_loader}\n}\n\n${_suffix}")
    # The serialized cache payload must also be binary on Windows.
    foreach(_mode r w a)
        string(REPLACE "pipeline_cache_filename.c_str(), \"${_mode}\")" "pipeline_cache_filename.c_str(), \"${_mode}b\")" _source "${_source}")
    endforeach()
    file(WRITE "${CMAKE_BINARY_DIR}/gui_vulkan_replay_consumer_base.cpp" "${_source}")
    list(REMOVE_ITEM _sources "${_original}")
    set_property(TARGET gfxrecon_decode PROPERTY SOURCES "${_sources}")
    target_sources(gfxrecon_decode PRIVATE "${CMAKE_BINARY_DIR}/gui_vulkan_replay_consumer_base.cpp")
endfunction()
cmake_language(DEFER CALL gfx_gui_replay_cache)
include("${CMAKE_CURRENT_LIST_DIR}/gui_dump_readback.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/gui_draw_visualization.cmake")
