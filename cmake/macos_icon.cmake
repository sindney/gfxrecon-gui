if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "INPUT PNG and OUTPUT icns paths are required")
endif()
find_program(SIPS sips REQUIRED)
find_program(ICONUTIL iconutil REQUIRED)
get_filename_component(_directory "${OUTPUT}" DIRECTORY)
set(_iconset "${_directory}/app.iconset")
file(MAKE_DIRECTORY "${_iconset}")
foreach(_size 16 32 128 256 512)
    math(EXPR _retina "${_size} * 2")
    foreach(_scale 1 2)
        if(_scale EQUAL 2)
            set(_pixels ${_retina})
            set(_name "icon_${_size}x${_size}@2x.png")
        else()
            set(_pixels ${_size})
            set(_name "icon_${_size}x${_size}.png")
        endif()
        execute_process(COMMAND "${SIPS}" -z ${_pixels} ${_pixels} "${INPUT}" --out "${_iconset}/${_name}"
            RESULT_VARIABLE _result OUTPUT_QUIET ERROR_VARIABLE _error)
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "Cannot resize app icon: ${_error}")
        endif()
    endforeach()
endforeach()
execute_process(COMMAND "${ICONUTIL}" -c icns -o "${OUTPUT}" "${_iconset}"
    RESULT_VARIABLE _result ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Cannot create app.icns: ${_error}")
endif()
