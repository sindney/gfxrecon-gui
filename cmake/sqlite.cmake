# Official amalgamation, verified against upstream SHA3 checksums when vendored.
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/thirdparty/sqlite/provenance.json" _sqlite_provenance)
foreach(_file sqlite3.c sqlite3.h)
    string(JSON _expected GET "${_sqlite_provenance}" files "${_file}")
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/thirdparty/sqlite/${_file}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Pinned SQLite source mismatch: ${_file}")
    endif()
endforeach()
add_library(gfxrecon_sqlite STATIC thirdparty/sqlite/sqlite3.c)
target_include_directories(gfxrecon_sqlite PUBLIC thirdparty/sqlite)
target_compile_definitions(gfxrecon_sqlite PRIVATE SQLITE_THREADSAFE=1 SQLITE_OMIT_LOAD_EXTENSION SQLITE_DQS=0 SQLITE_DEFAULT_MEMSTATUS=0)
target_link_libraries(gfxrecon_sqlite PRIVATE Threads::Threads)
if(UNIX)
    target_link_libraries(gfxrecon_sqlite PRIVATE m)
endif()
set_target_properties(gfxrecon_sqlite PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(MSVC)
    target_compile_definitions(gfxrecon_sqlite PRIVATE _CRT_SECURE_NO_WARNINGS)
endif()
