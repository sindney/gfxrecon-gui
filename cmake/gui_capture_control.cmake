# Generate a narrowly scoped host-layer event bridge without editing the SDK checkout.
if(WIN32)
    set_property(DIRECTORY PROPERTY GFX_GUI_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
    function(gfx_gui_capture_bridge)
        get_property(_root DIRECTORY PROPERTY GFX_GUI_ROOT)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_root}/cmake/gui_capture_event.inl")
        file(READ "${PROJECT_SOURCE_DIR}/framework/encode/capture_manager.cpp" _source)
        file(READ "${_root}/cmake/gui_capture_event.inl" _bridge)
        string(REPLACE "#include <cassert>" "#include <cassert>\n#if defined(_WIN32)\n#include <windows.h>\n#endif" _source "${_source}")
        string(REPLACE "static bool       previous_externally_set_trimming_state_g = false;"
            "static bool       previous_externally_set_trimming_state_g = false;\n${_bridge}" _source "${_source}")
        foreach(_method ExternalTriggerEnabled ExternalTriggerDisabled)
            set(_find "bool CommonCaptureManager::${_method}()\n{\n    std::lock_guard<std::mutex> set_trim_state_lock(external_trim_trigger_mutex_g);")
            string(FIND "${_source}" "${_find}" _at)
            if(_at LESS 0)
                message(FATAL_ERROR "Pinned capture manager changed; revalidate the GUI event bridge")
            endif()
            if(_method STREQUAL "ExternalTriggerEnabled")
                set(_edge "!previous_externally_set_trimming_state_g && externally_set_trimming_state_g")
            else()
                set(_edge "previous_externally_set_trimming_state_g && !externally_set_trimming_state_g")
            endif()
            string(REPLACE "${_find}" "${_find}\n    if (UpdateGuiCaptureEvent()) { const bool edge = ${_edge}; previous_externally_set_trimming_state_g = externally_set_trimming_state_g; return edge; }" _source "${_source}")
        endforeach()
        file(WRITE "${CMAKE_BINARY_DIR}/gui_capture_manager.cpp" "${_source}")
        get_target_property(_sources gfxrecon_encode SOURCES)
        list(REMOVE_ITEM _sources "${PROJECT_SOURCE_DIR}/framework/encode/capture_manager.cpp")
        set_property(TARGET gfxrecon_encode PROPERTY SOURCES "${_sources}")
        target_sources(gfxrecon_encode PRIVATE "${CMAKE_BINARY_DIR}/gui_capture_manager.cpp")
        find_package(Python3 COMPONENTS Interpreter REQUIRED)
        add_custom_target(gfxrecon_gui_capture_capability ALL COMMAND "${Python3_EXECUTABLE}"
            "${_root}/scripts/write_capture_capability.py" "$<TARGET_FILE:VkLayer_gfxreconstruct>" DEPENDS VkLayer_gfxreconstruct)
        add_dependencies(VkLayer_gfxreconstruct_json gfxrecon_gui_capture_capability)
    endfunction()
    cmake_language(DEFER CALL gfx_gui_capture_bridge)
endif()
