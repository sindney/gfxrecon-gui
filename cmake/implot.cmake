# Pinned, minimal ImPlot source subset. Demo sources are deliberately excluded.
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/dependencies.json" _implot_dependencies)
foreach(_file implot.h implot_internal.h implot.cpp implot_items.cpp LICENSE)
    string(JSON _expected GET "${_implot_dependencies}" implot files "${_file}")
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/thirdparty/implot/${_file}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Pinned ImPlot source mismatch: ${_file}")
    endif()
endforeach()
add_library(implot STATIC thirdparty/implot/implot.cpp thirdparty/implot/implot_items.cpp)
target_include_directories(implot PUBLIC thirdparty/implot)
target_link_libraries(implot PUBLIC imgui)
add_library(implot_tested STATIC thirdparty/implot/implot.cpp thirdparty/implot/implot_items.cpp)
target_include_directories(implot_tested PUBLIC thirdparty/implot)
target_link_libraries(implot_tested PUBLIC imgui_tested)
if(MSVC)
    target_compile_options(implot PRIVATE /utf-8)
    target_compile_options(implot_tested PRIVATE /utf-8)
endif()
