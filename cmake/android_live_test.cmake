# The GUI's debuggable test sample stays alive for human-triggered captures.
    function(gfx_gui_long_android_sample)
        if(NOT TARGET gfxrecon-testapp-triangle)
            return()
        endif()
        get_target_property(_sources gfxrecon-testapp-triangle SOURCES)
        get_target_property(_directory gfxrecon-testapp-triangle SOURCE_DIR)
        set(_patched FALSE)
        foreach(_source IN LISTS _sources)
            get_filename_component(_name "${_source}" NAME)
            if(_name STREQUAL "app.cpp")
                get_filename_component(_full "${_source}" ABSOLUTE BASE_DIR "${_directory}")
                file(READ "${_full}" _text)
                string(REGEX REPLACE "const int NUM_FRAMES = [0-9]+;" "const int NUM_FRAMES = 1000000;" _text "${_text}")
                file(WRITE "${CMAKE_BINARY_DIR}/gui_long_triangle.cpp" "${_text}")
                list(REMOVE_ITEM _sources "${_source}")
                list(APPEND _sources "${CMAKE_BINARY_DIR}/gui_long_triangle.cpp")
                set(_patched TRUE)
            endif()
        endforeach()
        set_property(TARGET gfxrecon-testapp-triangle PROPERTY SOURCES "${_sources}")
        if(NOT _patched)
            message(FATAL_ERROR "Could not generate the long-running GUI test sample: ${_sources}")
        endif()
    endfunction()
    cmake_language(DEFER CALL gfx_gui_long_android_sample)
