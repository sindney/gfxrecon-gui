# Vulkan probe instances can configure the same layer log repeatedly. Reopening
# an already-open ofstream poisons it; preserve the active stream and its logs.
include_guard(GLOBAL)
function(gfx_gui_capture_logging)
    if(NOT TARGET gfxrecon_util)
        return()
    endif()
    get_target_property(_directory gfxrecon_util SOURCE_DIR)
    set(_original "${_directory}/logging_targets.cpp")
    file(READ "${_original}" _source)
    set(_find "if (value != log_file_name_ || create_new_)")
    string(FIND "${_source}" "${_find}" _at)
    if(_at LESS 0)
        message(FATAL_ERROR "Pinned logging target changed; revalidate the capture logging fix")
    endif()
    string(REPLACE "${_find}" "if (value != log_file_name_ || !log_stream_.is_open())" _source "${_source}")
    file(WRITE "${CMAKE_BINARY_DIR}/gui_logging_targets.cpp" "${_source}")
    get_target_property(_sources gfxrecon_util SOURCES)
    list(REMOVE_ITEM _sources "${_original}")
    set_property(TARGET gfxrecon_util PROPERTY SOURCES "${_sources}")
    target_sources(gfxrecon_util PRIVATE "${CMAKE_BINARY_DIR}/gui_logging_targets.cpp")
    if(NOT ANDROID)
        add_executable(gfxrecon_capture_logging_test EXCLUDE_FROM_ALL
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/tests/capture_logging_driver.cpp")
        target_link_libraries(gfxrecon_capture_logging_test PRIVATE gfxrecon_util)
    endif()
endfunction()
cmake_language(DEFER CALL gfx_gui_capture_logging)
